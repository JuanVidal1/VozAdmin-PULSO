# AI provider — server-side only, never expose in NEXT_PUBLIC_ variables
OPENAI_API_KEY=

# Payments / notifications (configure when enabling those modules)
MERCADOPAGO_ACCESS_TOKEN=
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
