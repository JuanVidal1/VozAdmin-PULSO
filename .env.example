# Supabase — create a project and copy these values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public app origin used to build authentication email redirects
NEXT_PUBLIC_SITE_URL=
